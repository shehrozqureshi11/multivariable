# === Supabase PostgreSQL ===
# Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Local Postgres fallback (optional — docker compose profile "local-db")
# DATABASE_URL="postgresql://herdshare:herdshare@localhost:5433/herdshare?schema=public"

# === API ===
# Railway/Render inject PORT automatically; API_PORT is a local fallback
PORT=4000
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000
# Optional — omit in production if you have no Redis
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# === Supabase Storage (optional media) ===
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=animal-images

# === Web ===
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=HerdShare
